body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(to right, #3a1c71, #d76d77, #ffaf7b);
  color: #fff;
  text-align: center;
  margin: 0;
  padding: 0;
}

h1, #level-title {
  font-size: 2em;
  margin: 20px 0;
}

#question-container {
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 15px;
  padding: 30px;
  width: 90%;
  max-width: 600px;
  margin: 20px auto;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
}

#question {
  font-size: 1.5em;
  margin-bottom: 20px;
}

#answers {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

#answers button {
  background-color: #ffffff;
  color: #333;
  border: none;
  border-radius: 10px;
  padding: 12px;
  font-size: 1em;
  cursor: pointer;
  transition: transform 0.2s, background-color 0.3s;
}

#answers button:hover {
  background-color: #ffaf7b;
  transform: scale(1.05);
}

#confirm-button {
  margin-top: 20px;
  padding: 12px 20px;
  font-size: 1em;
  border: none;
  border-radius: 10px;
  background-color: #06d6a0;
  color: #fff;
  cursor: pointer;
  transition: background-color 0.3s, transform 0.2s;
  display: none;
}

#confirm-button:hover {
  background-color: #04b88a;
  transform: scale(1.05);
}

#next-button {
  margin-top: 20px;
  padding: 12px 20px;
  font-size: 1em;
  border: none;
  border-radius: 10px;
  background-color: #ffd166;
  color: #333;
  cursor: pointer;
  display: none;
  transition: background-color 0.3s, transform 0.2s;
}

#next-button:hover {
  background-color: #ffe28a;
  transform: scale(1.05);
}

#timer {
  font-size: 1.2em;
  margin-bottom: 10px;
}

#score {
  font-size: 1.3em;
  margin-top: 20px;
}
